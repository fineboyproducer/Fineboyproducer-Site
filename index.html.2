<style>
  :root{
    --black:#0a0a0a;
    --near-black:#111110;
    --offwhite:#f3f1ec;
    --paper:#eeece5;
    --gray:#4a4844;
    --gray-light:#8a877f;
    --gold:#b78a3d;
    --gold-soft:#cba15e;
    --line-dark: rgba(243,241,236,0.14);
    --line-light: rgba(10,10,10,0.12);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--black);
    color:var(--offwhite);
    font-family:'Inter',system-ui,sans-serif;
    font-weight:400;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  ::selection{background:var(--gold);color:var(--black);}
  h1,h2,h3,.display{
    font-family:'Fraunces',Georgia,serif;
    font-weight:500;
    letter-spacing:-0.01em;
    line-height:0.98;
    margin:0;
  }
  .eyebrow{
    font-size:12px;
    letter-spacing:0.16em;
    text-transform:uppercase;
    color:var(--gold-soft);
    font-weight:500;
  }
  .eyebrow.on-light{color:#8a5f22;}
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1240px;margin:0 auto;padding-left:24px;padding-right:24px;}
  @media(min-width:768px){.wrap{padding-left:48px;padding-right:48px;}}

  /* Buttons */
  .btn{
    display:inline-flex;align-items:center;gap:10px;
    padding:16px 30px;
    font-size:13px;letter-spacing:0.06em;text-transform:uppercase;font-weight:600;
    border:1px solid currentColor;
    transition:background .35s ease, color .35s ease, border-color .35s ease;
    white-space:nowrap;
  }
  .btn-gold{background:var(--gold);color:var(--black);border-color:var(--gold);}
  .btn-gold:hover{background:var(--gold-soft);border-color:var(--gold-soft);}
  .btn-outline-dark{color:var(--offwhite);border-color:rgba(243,241,236,0.4);}
  .btn-outline-dark:hover{border-color:var(--offwhite);}
  .btn-outline-light{color:var(--black);border-color:rgba(10,10,10,0.35);}
  .btn-outline-light:hover{border-color:var(--black);}

  /* Nav */
  #nav{
    position:fixed;top:0;left:0;right:0;z-index:100;
    padding:26px 0;
    border-bottom:1px solid transparent;
    transition:padding .4s ease, background .4s ease, border-color .4s ease;
  }
  #nav.scrolled{
    padding:14px 0;
    background:rgba(10,10,10,0.88);
    backdrop-filter:blur(10px);
    border-bottom-color:var(--line-dark);
  }
  .nav-inner{display:flex;align-items:center;justify-content:space-between;}
  .brand-mark{font-family:'Fraunces',serif;font-size:14px;letter-spacing:0.06em;font-weight:500;}
  .nav-links{display:none;gap:36px;font-size:13px;letter-spacing:0.02em;color:rgba(243,241,236,0.78);}
  .nav-links a{position:relative;padding:4px 0;}
  .nav-links a:hover{color:var(--offwhite);}
  @media(min-width:920px){.nav-links{display:flex;}}
  .nav-cta{display:none;}
  @media(min-width:920px){.nav-cta{display:inline-flex;}}
  .hamburger{display:flex;flex-direction:column;gap:5px;width:26px;cursor:pointer;background:none;border:0;padding:8px 0;}
  @media(min-width:920px){.hamburger{display:none;}}
  .hamburger span{height:1px;background:var(--offwhite);width:100%;transition:transform .3s ease, opacity .3s ease;}
  #mobile-menu{
    position:fixed;inset:0;background:var(--black);z-index:99;
    display:flex;flex-direction:column;justify-content:center;gap:28px;padding:24px;
    transform:translateY(-100%);transition:transform .45s ease;
  }
  #mobile-menu.open{transform:translateY(0);}
  #mobile-menu a{font-family:'Fraunces',serif;font-size:32px;}

  /* Reveal */
  .reveal{opacity:0;transform:translateY(28px);transition:opacity .8s ease, transform .8s ease;}
  .reveal.visible{opacity:1;transform:translateY(0);}
  @media (prefers-reduced-motion: reduce){
    .reveal{opacity:1;transform:none;transition:none;}
    html{scroll-behavior:auto;}
  }

  section{position:relative;}
  .section-dark{background:var(--black);color:var(--offwhite);}
  .section-light{background:var(--offwhite);color:var(--black);}

  .rule{height:1px;background:var(--line-dark);width:100%;}
  .rule.on-light{background:var(--line-light);}

  /* Hero */
  .hero{min-height:100svh;display:flex;align-items:center;padding-top:110px;padding-bottom:60px;}
  .hero-grid{display:grid;grid-template-columns:1fr;gap:56px;align-items:center;}
  @media(min-width:1024px){.hero-grid{grid-template-columns:1.05fr 0.95fr;gap:40px;}}
  .hero-headline{font-size:clamp(44px,8vw,86px);}
  .portrait-frame{
    position:relative;aspect-ratio:4/5;background:linear-gradient(155deg,#1c1c1a,#0a0a0a 70%);
    border:1px solid var(--line-dark);overflow:hidden;
  }
  .portrait-frame .grain{position:absolute;inset:0;background:
    radial-gradient(circle at 30% 20%, rgba(183,138,61,0.10), transparent 55%),
    repeating-linear-gradient(115deg, rgba(255,255,255,0.02) 0 2px, transparent 2px 6px);}
  .portrait-frame .label{
    position:absolute;bottom:20px;left:20px;right:20px;
    display:flex;justify-content:space-between;align-items:flex-end;
    font-size:11px;letter-spacing:0.08em;color:rgba(243,241,236,0.55);text-transform:uppercase;
  }
  .portrait-frame .placeholder-icon{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  }
  .portrait-frame img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 20%;
  }
  .about-portrait img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:60% 30%;
  }
  .portrait-frame .shade{
    position:absolute;inset:0;background:linear-gradient(180deg, rgba(10,10,10,0) 55%, rgba(10,10,10,0.55) 100%);
  }
  .parallax-el{transition:transform .1s linear;}

  /* Problem blocks */
  .problem-grid{display:grid;grid-template-columns:1fr;gap:0;border-top:1px solid var(--line-light);margin-top:56px;}
  @media(min-width:860px){.problem-grid{grid-template-columns:repeat(3,1fr);}}
  .problem-block{padding:40px 8px 40px 0;border-bottom:1px solid var(--line-light);}
  @media(min-width:860px){.problem-block{border-right:1px solid var(--line-light);padding:44px 32px;}
    .problem-block:last-child{border-right:none;}}
  .problem-block h3{font-size:20px;margin-bottom:14px;font-weight:500;}
  .problem-block p{color:var(--gray);font-size:15px;line-height:1.6;max-width:34ch;}

  /* Pillars */
  .pillars{display:grid;grid-template-columns:1fr;margin-top:64px;border-top:1px solid var(--line-dark);}
  @media(min-width:860px){.pillars{grid-template-columns:repeat(4,1fr);}}
  .pillar{padding:36px 8px;border-bottom:1px solid var(--line-dark);}
  @media(min-width:860px){.pillar{border-right:1px solid var(--line-dark);padding:40px 26px;}
    .pillar:last-child{border-right:none;}}
  .pillar .num{font-family:'Fraunces',serif;font-size:15px;color:var(--gold-soft);margin-bottom:26px;display:block;}
  .pillar h3{font-size:19px;margin-bottom:12px;font-weight:500;}
  .pillar p{color:rgba(243,241,236,0.62);font-size:14.5px;line-height:1.6;max-width:30ch;}

  /* Stats */
  .stats{display:grid;grid-template-columns:1fr;gap:36px;margin-top:56px;}
  @media(min-width:720px){.stats{grid-template-columns:repeat(3,1fr);gap:24px;}}
  .stat-num{font-family:'Fraunces',serif;font-size:clamp(40px,6vw,64px);font-weight:500;color:var(--black);}
  .stat-label{font-size:12.5px;letter-spacing:0.08em;text-transform:uppercase;color:var(--gray);margin-top:8px;}

  .case-frame{
    margin-top:64px;border:1px solid var(--line-light);background:#e4e1d8;
    position:relative;overflow:hidden;
  }
  .case-frame img{width:100%;height:auto;display:block;}

  /* Product sections */
  .feature-list{list-style:none;padding:0;margin:28px 0 0;display:grid;grid-template-columns:1fr;gap:12px 28px;}
  @media(min-width:640px){.feature-list{grid-template-columns:1fr 1fr;}}
  .feature-list li{font-size:14.5px;padding-left:20px;position:relative;color:rgba(243,241,236,0.75);}
  .feature-list li::before{content:"";position:absolute;left:0;top:9px;width:9px;height:1px;background:var(--gold-soft);}

  .process{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin:40px 0;font-family:'Fraunces',serif;font-size:clamp(20px,3.4vw,30px);color:rgba(243,241,236,0.9);}
  .process .arrow{color:var(--gold-soft);font-size:20px;}

  .agi-grid{display:grid;grid-template-columns:1fr;gap:0;margin-top:8px;border-top:1px solid var(--line-dark);}
  @media(min-width:860px){.agi-grid{grid-template-columns:repeat(3,1fr);}}
  .agi-card{padding:32px 8px;border-bottom:1px solid var(--line-dark);}
  @media(min-width:860px){.agi-card{border-right:1px solid var(--line-dark);padding:36px 28px;}
    .agi-card:last-child{border-right:none;}}
  .agi-card h3{font-size:17px;font-weight:500;margin-bottom:10px;}
  .agi-card p{font-size:14.5px;color:rgba(243,241,236,0.62);line-height:1.6;}

  /* Video cards */
  .video-grid{display:grid;grid-template-columns:1fr;gap:28px;margin-top:48px;}
  @media(min-width:760px){.video-grid{grid-template-columns:repeat(3,1fr);}}
  .video-card{border:1px solid var(--line-light);}
  .video-thumb{aspect-ratio:16/9;background:linear-gradient(160deg,#e4e1d8,#d8d5cb);position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;}
  .video-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .video-thumb .play-ring{position:relative;z-index:1;background:rgba(255,255,255,0.92);}
  .soon-badge{position:absolute;top:12px;left:12px;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;background:var(--black);color:var(--offwhite);padding:5px 10px;z-index:1;}
  .play-ring{width:52px;height:52px;border-radius:50%;border:1px solid rgba(10,10,10,0.3);display:flex;align-items:center;justify-content:center;}
  .video-card h4{font-size:15px;font-weight:500;padding:18px 18px 20px;line-height:1.4;}

  /* Who this is for */
  .statements{display:grid;grid-template-columns:1fr;gap:0;margin-top:48px;border-top:1px solid var(--line-dark);}
  .statement{padding:22px 0;border-bottom:1px solid var(--line-dark);font-family:'Fraunces',serif;font-size:clamp(18px,2.6vw,24px);color:rgba(243,241,236,0.9);}

  /* About */
  .about-grid{display:grid;grid-template-columns:1fr;gap:48px;}
  @media(min-width:900px){.about-grid{grid-template-columns:0.85fr 1.15fr;gap:64px;}}
  .about-portrait{position:relative;aspect-ratio:4/5;background:linear-gradient(160deg,#1c1c1a,#0a0a0a 70%);border:1px solid var(--line-dark);overflow:hidden;}

  /* Waveform */
  .waveform{display:flex;align-items:flex-end;gap:3px;height:34px;opacity:0.6;}
  .waveform span{width:2px;background:var(--gold-soft);}

  /* Footer */
  footer{background:var(--black);color:rgba(243,241,236,0.65);padding:64px 0 32px;}
  .footer-grid{display:grid;grid-template-columns:1fr;gap:40px;}
  @media(min-width:760px){.footer-grid{grid-template-columns:1.3fr 1fr 1fr;}}
  footer h5{font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(243,241,236,0.4);margin-bottom:16px;font-weight:500;}
  .footer-links{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;font-size:14px;}
  .footer-links a:hover{color:var(--offwhite);}

  .sticky-cta{
    position:fixed;bottom:0;left:0;right:0;z-index:90;background:var(--gold);color:var(--black);
    display:flex;justify-content:center;padding:14px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;
    transform:translateY(100%);transition:transform .4s ease;
  }
  .sticky-cta.show{transform:translateY(0);}
  @media(min-width:920px){.sticky-cta{display:none;}}

  .counted{font-variant-numeric:tabular-nums;}
</style>
</head>
