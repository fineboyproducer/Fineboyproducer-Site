<script>
(function(){
  // Nav scroll state
  var nav = document.getElementById('nav');
  var sticky = document.getElementById('sticky-cta');
  window.addEventListener('scroll', function(){
    var y = window.scrollY;
    if(y > 40){ nav.classList.add('scrolled'); } else { nav.classList.remove('scrolled'); }
    if(y > 700){ sticky.classList.add('show'); } else { sticky.classList.remove('show'); }
  }, {passive:true});

  // Mobile menu
  var hb = document.getElementById('hamburger-btn');
  var mm = document.getElementById('mobile-menu');
  hb.addEventListener('click', function(){
    var open = mm.classList.toggle('open');
    hb.setAttribute('aria-expanded', open ? 'true':'false');
  });
  document.querySelectorAll('.mm-link').forEach(function(l){
    l.addEventListener('click', function(){ mm.classList.remove('open'); hb.setAttribute('aria-expanded','false'); });
  });

  // Reveal on scroll
  var revealEls = document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); }
      });
    }, {threshold:0.12, rootMargin:'0px 0px -40px 0px'});
    revealEls.forEach(function(el){ io.observe(el); });
  } else {
    revealEls.forEach(function(el){ el.classList.add('visible'); });
  }

  // Counting stats
  var counters = document.querySelectorAll('.counted');
  var counted = false;
  function runCount(){
    if(counted) return; counted = true;
    counters.forEach(function(el){
      var target = parseInt(el.getAttribute('data-count'), 10);
      var start = 0; var dur = 1400; var startTime = null;
      function step(ts){
        if(!startTime) startTime = ts;
        var progress = Math.min((ts - startTime) / dur, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(eased * target).toLocaleString();
        if(progress < 1) requestAnimationFrame(step);
        else el.textContent = target.toLocaleString();
      }
      requestAnimationFrame(step);
    });
  }
  var statSection = document.querySelector('.stat-num');
  if(statSection && 'IntersectionObserver' in window){
    var statIo = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ runCount(); statIo.disconnect(); } });
    }, {threshold:0.4});
    statIo.observe(statSection.closest('.stats'));
  } else { runCount(); }

  // Subtle hero parallax
  var portrait = document.querySelector('.parallax-el');
  window.addEventListener('mousemove', function(e){
    if(!portrait || window.innerWidth < 1024) return;
    var x = (e.clientX / window.innerWidth - 0.5) * 10;
    var y = (e.clientY / window.innerHeight - 0.5) * 10;
    portrait.style.transform = 'translate(' + x + 'px,' + y + 'px)';
  }, {passive:true});

  // Waveform bars
  var wf = document.getElementById('waveform');
  if(wf){
    var heights = [10,18,26,14,30,20,34,16,24,12,28,18,10,22,16];
    heights.forEach(function(h){
      var bar = document.createElement('span');
      bar.style.height = h + 'px';
      wf.appendChild(bar);
    });
  }
})();
</script>

